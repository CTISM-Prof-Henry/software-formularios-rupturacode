# Configuração do backend Django (atlas).
# Em desenvolvimento local nada precisa ser definido — os defaults já funcionam.
# Em produção, exporte estas variáveis no ambiente antes de subir o servidor.

# Chave secreta do Django. OBRIGATÓRIA em produção (gere uma nova, mantenha secreta).
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte

# Liga/desliga o modo debug. Use False em produção.
DJANGO_DEBUG=False

# Hosts permitidos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com
